Panels:
  - Class: rviz_visual_tools/RvizVisualToolsGui
    Name: RvizVisualToolsGui
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /PenInk1
      Splitter Ratio: 0.5
    Tree Height: 700
Visualization Manager:
  Class: ""
  Name: root
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Alpha: 0.4
      Cell Size: 0.1
      Color: 160; 160; 164
      Line Style:
        Line Width: 0.03
        Value: Lines
      Plane: XY
      Plane Cell Count: 20
      Reference Frame: world
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Alpha: 1
      Collision Enabled: false
      Visual Enabled: true
      Description Source: Topic
      Description Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_description
      TF Prefix: ""
      Value: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
      Marker Scale: 0.2
      Show Arrows: false
      Show Axes: true
      Show Names: false
      Value: false
    - Class: rviz_default_plugins/Marker
      Name: Waypoints
      Enabled: true
      Namespaces: {}
      Topic:
        Depth: 200
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /pen_waypoints
      Value: true
    # Net muc dung Durability = Transient Local nen mo RViz sau van thay du net.
    - Class: rviz_default_plugins/Marker
      Name: PenInk
      Enabled: true
      Namespaces: {}
      Topic:
        Depth: 200
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /pen_ink
      Value: true
  Global Options:
    Background Color: 40; 42; 48
    Fixed Frame: world
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/FocusCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 1.0
      Focal Point:
        X: 0.32
        Y: 0
        Z: 0.28
      Pitch: 0.3
      Yaw: 3.55
      Target Frame: world
      Near Clip Distance: 0.01
      Value: Orbit (rviz)
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 1000
  Width: 1500
  Hide Left Dock: false
  Hide Right Dock: false
  RvizVisualToolsGui:
    collapsed: false
  QMainWindow State: ""
